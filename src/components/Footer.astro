---
const year = new Date().getFullYear();
const cols = [
	{
		title: 'Услуги',
		links: ['Проектирование', 'Строительство «под ключ»', 'Коммерческие объекты', 'Реконструкция', 'Отделка'],
	},
	{
		title: 'Компания',
		links: ['О нас', 'Проекты', 'Как мы работаем', 'Отзывы', 'Вакансии'],
	},
];
---

<footer class="pt-16 pb-8" style="background: var(--night); color: var(--paper); border-top: 1px solid rgba(255,255,255,0.08);">
	<div class="max-w-[1280px] mx-auto px-5 sm:px-8">
		<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 pb-14">
			<!-- Бренд -->
			<div class="lg:col-span-2 max-w-sm">
				<div class="flex items-center gap-3">
					<span class="grid place-items-center w-9 h-9 rounded-md text-white text-lg font-bold" style="background: var(--accent);">М</span>
					<span class="font-display text-xl font-bold">МОНОЛИТ</span>
				</div>
				<p class="text-white/55 mt-5 leading-relaxed">
					Строительная компания полного цикла. Проектируем, строим и сдаём объекты «под ключ» с гарантией до 10 лет.
				</p>
				<a href="#contact" class="btn btn-accent mt-7">Обсудить проект</a>
			</div>

			{cols.map((col) => (
				<div>
					<h4 class="eyebrow text-white/40 mb-5">{col.title}</h4>
					<ul class="space-y-3">
						{col.links.map((l) => (
							<li><a href="#" class="text-white/70 hover:text-white transition-colors">{l}</a></li>
						))}
					</ul>
				</div>
			))}
		</div>

		<div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-white/45" style="border-top: 1px solid rgba(255,255,255,0.08);">
			<p>© {year} «МОНОЛИТ». Все права защищены.</p>
			<div class="flex items-center gap-6">
				<a href="#" class="hover:text-white transition-colors">Политика конфиденциальности</a>
				<a href="tel:+74951234567" class="hover:text-white transition-colors">+7 (495) 123-45-67</a>
			</div>
		</div>
	</div>
</footer>
