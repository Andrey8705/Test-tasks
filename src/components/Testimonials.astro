---
const reviews = [
	{
		text: 'Дом сдали на две недели раньше срока, смета не выросла ни на рубль. За 8 месяцев ни одного неприятного сюрприза — только фотоотчёты каждую пятницу.',
		name: 'Андрей Соколов',
		role: 'Частный дом, 320 м²',
	},
	{
		text: 'Строили бизнес-центр — сложный объект с жёсткими сроками. Команда «МОНОЛИТ» держала график и сама решала вопросы с согласованиями. Рекомендую.',
		name: 'Марина Лебедева',
		role: 'Девелопер, БЦ «Меридиан»',
	},
	{
		text: 'Заказывал реконструкцию старого здания. Усилили конструктив, сделали перепланировку — всё аккуратно и по документам. Приятно работать с профессионалами.',
		name: 'Игорь Тарасов',
		role: 'Собственник, реконструкция',
	},
];
---

<section class="py-24 sm:py-32" style="background: var(--paper-2);">
	<div class="max-w-[1280px] mx-auto px-5 sm:px-8">
		<div class="reveal flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14">
			<div>
				<span class="eyebrow" style="color: var(--accent);">05 — Отзывы</span>
				<h2 class="font-display text-[clamp(2rem,4.5vw,3.5rem)] font-bold leading-[1.05] mt-4">
					Нам доверяют<br class="hidden sm:block" /> самое важное
				</h2>
			</div>
			<div class="flex items-center gap-3 text-[var(--muted)]">
				<div class="flex" style="color: var(--accent);">
					{[0,1,2,3,4].map(() => (
						<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.6-5.2 4.5 1.6 6.7L12 17.3 5.8 20.6l1.6-6.7L2.2 8.9l6.9-.6z"/></svg>
					))}
				</div>
				<span class="text-sm">4.9 из 5 · 180+ отзывов</span>
			</div>
		</div>

		<div class="grid md:grid-cols-3 gap-5">
			{reviews.map((r, i) => (
				<figure class="reveal bg-[var(--paper)] rounded-2xl p-8 flex flex-col border" style={`border-color: var(--line); --reveal-delay: ${i * 100}ms;`}>
					<svg width="40" height="40" viewBox="0 0 24 24" fill="var(--accent)" class="opacity-20"><path d="M9.5 7C6.5 7 5 9.5 5 12v5h5v-5H7.5c0-1.5.5-3 2-3V7zm9 0c-3 0-4.5 2.5-4.5 5v5h5v-5H16c0-1.5.5-3 2-3V7z"/></svg>
					<blockquote class="text-[var(--ink-soft)] leading-relaxed mt-4 flex-1">{r.text}</blockquote>
					<figcaption class="mt-6 pt-6 border-t flex items-center gap-3" style="border-color: var(--line);">
						<span class="grid place-items-center w-11 h-11 rounded-full font-display font-bold text-white shrink-0" style="background: var(--accent);">{r.name.charAt(0)}</span>
						<span class="leading-tight">
							<span class="block font-semibold">{r.name}</span>
							<span class="block text-sm text-[var(--muted)]">{r.role}</span>
						</span>
					</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>
